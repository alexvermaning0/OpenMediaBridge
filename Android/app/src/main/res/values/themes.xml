<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.OpenMediaBridge" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">#1E1E1E</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">#FDE68A</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">#0A0A0A</item>
        <item name="colorSurface">#111111</item>
        <item name="colorOnSurface">@color/white</item>
        <item name="android:windowBackground">#0A0A0A</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#0A0A0A</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="materialButtonStyle">@style/OMBButton</item>
    </style>

    <style name="OMBButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">#CCFFFFFF</item>
        <item name="strokeColor">#30FFFFFF</item>
        <item name="rippleColor">#20FFFFFF</item>
    </style>

</resources>
